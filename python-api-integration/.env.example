# ── Facebook / Meta Ads ──────────────────────────────────────────────────────
FB_ACCESS_TOKEN=your_meta_system_user_access_token
FB_AD_ACCOUNT_ID=act_123456789          # must start with "act_"
FB_API_VERSION=v20.0                    # optional, defaults to v20.0

# ── Google Ads ────────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890      # 10-digit, no hyphens
GOOGLE_ADS_LOGIN_CUSTOMER_ID=          # optional MCC account id

# ── TikTok Ads ───────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=your_access_token
TIKTOK_ADVERTISER_ID=your_advertiser_id
TIKTOK_APP_ID=                         # optional
TIKTOK_SECRET=                         # optional

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxx
SHOPIFY_API_VERSION=2024-07            # optional

# ── WooCommerce ───────────────────────────────────────────────────────────────
WOO_STORE_URL=https://your-store.com
WOO_CONSUMER_KEY=ck_xxxx
WOO_CONSUMER_SECRET=cs_xxxx

# ── Amazon SP-API ─────────────────────────────────────────────────────────────
AMAZON_REFRESH_TOKEN=Atzr|...
AMAZON_CLIENT_ID=amzn1.application-oa2-client....
AMAZON_CLIENT_SECRET=your_secret
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER   # US marketplace
AMAZON_SELLER_ID=your_seller_id
AMAZON_REGION=us-east-1               # optional

# ── Generic Supplier REST API ─────────────────────────────────────────────────
SUPPLIER_BASE_URL=https://api.your-supplier.com/v1
SUPPLIER_API_KEY=your_api_key
SUPPLIER_API_KEY_HEADER=X-Api-Key     # optional header name
